            "hash": "a893ede29b17452f4f814b39b707a82348ac2f479d3acac18db32bb076fc82d7"
        },
        "arm64": {
            "url": "https://github.com/lyswhut/lx-music-desktop/releases/download/v2.12.3/lx-music-desktop-v2.12.3-win_arm64-green.7z",
            "hash": "c8d0bb313e3fa779d6292636b8447e1ee0458e4533a648bbf6245ff1c82fd61e"
